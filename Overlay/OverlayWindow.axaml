<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clockwork.Overlay"
        x:Class="Clockwork.Overlay.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="Clockwork Overlay"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Focusable="False"
        SizeToContent="WidthAndHeight">

    <Window.Styles>
        <!-- Transparent-background mode: use vivid, high-chroma text and a black halo. -->
        <Style Selector="Border.overlayRoot TextBlock.overlayLabel">
            <Setter Property="Foreground" Value="#FFFF00" />
        </Style>
        <Style Selector="Border.overlayRoot TextBlock.overlayValue">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Border.overlayRoot.transparent">
            <Setter Property="Effect">
                <DropShadowEffect Color="#000000" BlurRadius="2" OffsetX="0" OffsetY="0" Opacity="1" />
            </Setter>
        </Style>
        <Style Selector="Border.overlayRoot.transparent TextBlock.overlayLabel">
            <Setter Property="Foreground" Value="#FFD400" />
        </Style>
        <Style Selector="Border.overlayRoot.transparent TextBlock.overlayValue">
            <Setter Property="Foreground" Value="#00E5FF" />
        </Style>
    </Window.Styles>

    <LayoutTransformControl x:Name="ScaleContainer"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </LayoutTransformControl.LayoutTransform>

        <Border x:Name="OverlayBackgroundBorder"
                Classes="overlayRoot"
                Background="#F0000000"
                Padding="4,3"
                CornerRadius="1">
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="vm:OverlayLine">
                        <Grid ColumnDefinitions="Auto,Auto" MinHeight="16">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       Classes="overlayLabel"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       LineHeight="16"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas,Cascadia Mono,monospace"
                                       TextWrapping="NoWrap" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       Classes="overlayValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       LineHeight="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"
                                       MinWidth="48"
                                       Margin="6,0,0,0"
                                       FontFamily="Consolas,Cascadia Mono,monospace"
                                       TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </Border>
    </LayoutTransformControl>
</Window>