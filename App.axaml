<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Clockwork.App"
             RequestedThemeVariant="Dark">

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/Icons/Clockwork.ico"
                ToolTipText="Clockwork"
                Clicked="TrayIcon_OnClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open Clockwork" Click="ShowWindow_OnClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Close Clockwork" Click="ExitClockwork_OnClick" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <Application.Resources>
    <!-- Surfaces: Midnight slate tinted to harmonise with #6D8DFF -->
    <SolidColorBrush x:Key="AppBackground" Color="#0C0E14" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#0F131D" />
    <SolidColorBrush x:Key="PanelBorder" Color="#1E2536" />
    <SolidColorBrush x:Key="CardBackground" Color="#151A26" />
    <SolidColorBrush x:Key="CardBorder" Color="#242D42" />
    <SolidColorBrush x:Key="RowDivider" Color="#1C2232" />
    <SolidColorBrush x:Key="NavHover" Color="#192030" />
    <SolidColorBrush x:Key="NavSelected" Color="#1E2842" />

    <!-- Title bar buttons -->
    <SolidColorBrush x:Key="CaptionHover" Color="#181F2E" />
    <SolidColorBrush x:Key="CaptionPressed" Color="#222B3D" />
    <SolidColorBrush x:Key="CaptionCloseHover" Color="#E05252" />
    <SolidColorBrush x:Key="CaptionClosePressed" Color="#B83A3A" />

    <!-- Text / icons -->
    <SolidColorBrush x:Key="TextPrimary" Color="#EDF1F7" />
    <SolidColorBrush x:Key="TextMuted" Color="#939EB5" />
    <SolidColorBrush x:Key="TextSubtle" Color="#647088" />

    <!-- Accent + switch -->
    <SolidColorBrush x:Key="Accent" Color="#6D8DFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#829EFF" />
    <SolidColorBrush x:Key="SwitchOff" Color="#252D3D" />
    <SolidColorBrush x:Key="SwitchOffHover" Color="#2F394D" />
    <SolidColorBrush x:Key="SwitchKnobOff" Color="#CBD3E1" />
    <SolidColorBrush x:Key="SwitchKnobOn" Color="#FFFFFF" />

    <!-- Secondary controls -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#1A202E" />
    <SolidColorBrush x:Key="ButtonHover" Color="#222A3C" />
    <SolidColorBrush x:Key="ButtonPressed" Color="#2A344A" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#283247" />
  </Application.Resources>

</Application>